# For an nginx host: a server block for todora.lukschander.com (certbot or
# your existing TLS setup provides the certificate lines).
server {
    listen 443 ssl http2;
    server_name todora.lukschander.com;
    # ssl_certificate     /etc/letsencrypt/live/todora.lukschander.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/todora.lukschander.com/privkey.pem;
    client_max_body_size 300k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        # No access log: addresses are only for rate limits, in memory.
        access_log off;
    }
}
